{
    "name": "rabbanist/admin-dashboard",
    "description": "A comprehensive admin dashboard package for Laravel",
    "keywords": ["laravel", "admin", "dashboard", "panel", "rbac", "roles", "privileges"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rabbanist",
            "email": "golamrabbanig5@gmail.com",
            "homepage": "https://github.com/rabbanist"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/auth": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rabbanist\\AdminDashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rabbanist\\AdminDashboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rabbanist\\AdminDashboard\\AdminDashboardServiceProvider"
            ],
            "aliases": {
                "AdminDashboard": "Rabbanist\\AdminDashboard\\Facades\\AdminDashboard"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
