{
    "name": "yourvendor/admin-dashboard",
    "description": "A comprehensive admin dashboard package for Laravel 12/13",
    "keywords": ["laravel", "admin", "dashboard", "panel"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Yourvendor",
            "email": "dev@yourvendor.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Yourvendor\\AdminDashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yourvendor\\AdminDashboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yourvendor\\AdminDashboard\\AdminDashboardServiceProvider"
            ],
            "aliases": {
                "AdminDashboard": "Yourvendor\\AdminDashboard\\Facades\\AdminDashboard"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
